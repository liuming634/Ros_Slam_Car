<?xml version="1.0"?>
<!-- ============================================================
     vi_car 小车 URDF
     定义 TF 树（static）：base_link -> laser_link / camera_link / imu_link
     供 robot_state_publisher 发布静态坐标变换，
     Cartographer 依赖这些变换把传感器数据转到 tracking_frame(base_link)。

     ⚠️ 安装位置/尺寸为占位值，装好实车后按实际安装调整 origin。
     ============================================================ -->
<robot name="vi_car">

  <!-- 底盘（tracking_frame / published_frame） -->
  <link name="base_link"/>

  <!-- 激光雷达：安装在底盘上方居中，向前 -->
  <link name="laser_link"/>
  <joint name="base_to_laser" type="fixed">
    <parent link="base_link"/>
    <child  link="laser_link"/>
    <origin xyz="0.0 0.0 0.15" rpy="0 0 0"/>
  </joint>

  <!-- 相机：安装在底盘前上方（FPV 图传 / USB 摄像头） -->
  <link name="camera_link"/>
  <joint name="base_to_camera" type="fixed">
    <parent link="base_link"/>
    <child  link="camera_link"/>
    <origin xyz="0.10 0.0 0.10" rpy="0 0 0"/>
  </joint>

  <!-- IMU：安装在底盘中心附近 -->
  <link name="imu_link"/>
  <joint name="base_to_imu" type="fixed">
    <parent link="base_link"/>
    <child  link="imu_link"/>
    <origin xyz="0.0 0.0 0.05" rpy="0 0 0"/>
  </joint>

</robot>
